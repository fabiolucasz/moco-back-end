# ==============================================================================
# FinPilot Backend — Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Security & JWT Tokens
# Generate a strong 32-byte secret in production: openssl rand -hex 32
SECRET_KEY=change-this-in-production-super-secret-key-finpilot-2026-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Development Database (PostgreSQL)
POSTGRES_USER=finpilot_user
POSTGRES_PASSWORD=finpilot_password
POSTGRES_DB=finpilot_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://finpilot_user:finpilot_password@localhost:5432/finpilot_db

# Production Database (PostgreSQL SUPABASE)
SCHEME=postgresql+asyncpg
USER=USER
PASSWORD=PASSWORD
HOST=HOST
PORT=PORT
DATABASE_NAME=DATABASE_NAME
PROD_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE_NAME

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081","http://localhost:19006"]

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

AWS_ROLE_ARN=